<Project Sdk="Microsoft.NET.Sdk" InitialTargets="KatanaCheckSubmodule">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <NativeOutputDir>$(MSBuildThisFileDirectory)..\ParticleRecorder.Native\Build\x64\$(Configuration)\</NativeOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KatanaEngine\WinForms\KatanaEngine.WinForms.csproj" />

    <!-- Build order only: the native game DLL is loaded at runtime by KatanaViewport. -->
    <ProjectReference Include="..\ParticleRecorder.Native\ParticleRecorder.Native.vcxproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

  <!-- A plain "git clone" leaves the KatanaEngine submodule empty; fail with one clear message. -->
  <Target Name="KatanaCheckSubmodule">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\KatanaEngine\KatanaEngine.props')" Text="The KatanaEngine submodule is missing (the KatanaEngine folder is empty). Run 'git submodule update --init' in the ParticleRecorder folder, then reload the solution." />
  </Target>

  <!-- Copy the native game DLL and its Allegro DLLs next to the exe (after they exist). -->
  <Target Name="CopyNativeGame" AfterTargets="Build">
    <ItemGroup>
      <NativeGameFiles Include="$(NativeOutputDir)*.dll;$(NativeOutputDir)*.pdb" />
    </ItemGroup>
    <Error Condition="'@(NativeGameFiles)' == ''" Text="No native build output in $(NativeOutputDir). Build ParticleRecorder.Native (x64, $(Configuration)) first." />
    <Copy SourceFiles="@(NativeGameFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
